# Fixtures locais, sem backend. Para usar Supabase, remova estas duas opções
# e configure VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY no .env ignorado.
# Com URL/chave presentes e sem VITE_DATA_MODE, a aplicação seleciona Supabase.
VITE_DATA_MODE=demo
VITE_DEMO_MODE=true
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<chave-publica>

# Núcleo do release: edição da própria conta, notificações e carteira Admin.
# Somente build publicado em https://app.calirh.com com destino CALI MAPA.
# VITE_CALI_RELEASE_CORE=true

# Homologação: build publicado no Vercel e projeto Supabase separado do CALI MAPA.
# Configure staging.calirh.com ou o alias Vercel exato, sem barra final, e use o projeto Supabase de teste.
# VITE_CALI_PREVIEW_ORIGIN=https://<alias-do-preview>.vercel.app

# Consultas da fase 4: Vite dev no piloto A/B ou preview isolado, após preparar as RPCs.
# VITE_CALI_PHASE4_READ=true
# Operações locais de homologação, após instalar as propostas SQL com transporte isolado.
# VITE_CALI_PHASE4_WRITE=true
# Agenda Google: somente preview isolado, após preparar a função e um calendário de teste.
# VITE_CALI_GOOGLE_CALENDAR_SYNC=true

# Partner sintético no preview isolado ou no piloto local após instalar a fase 5.
# VITE_CALI_PHASE5_PARTNER=true

# PDF executivo: ativar só após instalar as RPCs e a Edge com JWT obrigatório.
# VITE_CALI_PHASE4_REPORT_RELEASE=true

# Auditoria e propostas: só leitura no piloto, após instalar as RPCs correspondentes.
# VITE_CALI_PHASE4_ADMIN_READ=true

# E-mail comercial sintético. Ativar somente no preview isolado ou no loopback com a Edge de teste.
# VITE_CALI_PHASE4_COMMERCIAL_EMAIL=true

# Devolutiva sintética do Mapa. Usar somente com a Edge de teste habilitada.
# VITE_CALI_PHASE4_MAPA_EMAIL=true
# VITE_CALI_PREVIEW_MAPA_EMAIL=true
